# Company OS — local configuration. `cp .env.example .env` then fill. NEVER commit .env.
# This file holds VARIABLE NAMES and non-secret defaults. Values go in .env only.

# --- identity ---------------------------------------------------------------------------
COMPANY_OS_SLUG=company                 # short id, used for scheduler labels (com.company-os.<slug>.<job>)

# --- engine & models ---------------------------------------------------------------------
COMPANY_OS_ENGINE=claude                # claude | codex  (default engine for run-agent.sh)
COMPANY_OS_MODEL=                       # Claude model id for agent runs (empty = CLI default)
COMPANY_OS_EFFORT=                      # Claude effort level if your CLI supports --effort (empty = default)
COMPANY_OS_CODEX_MODEL=                 # Codex model (empty = CLI default)
COMPANY_OS_CODEX_EFFORT=                # Codex reasoning effort (empty = default)
# Model tiers used by scripts/route-model.sh (policies/model-routing.md). Empty = same as COMPANY_OS_MODEL.
COMPANY_OS_MODEL_CHEAP=
COMPANY_OS_MODEL_MID=
COMPANY_OS_MODEL_HIGH=
COMPANY_OS_MODEL_AUDIT=
COMPANY_OS_BALANCE_PROVIDERS=0          # 1 = alternate claude/codex on eligible tasks (two plans, ~50/50)

# --- unattended runs ---------------------------------------------------------------------
# 1 = agents run without a human approving each tool call (required for scheduled runs).
# The safety net is then RULES.md, read-only connectors and the T3 gate. Understand before enabling.
COMPANY_OS_BYPASS_PERMISSIONS=0

# --- notifications (P0 only — RULES R5) ---------------------------------------------------
# One of: a Slack/Discord incoming webhook, or a Telegram bot. Empty = print to logs/notify.log.
NOTIFY_WEBHOOK_URL=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# --- connectors (add one block per system of record — names only here, values in .env) ---
# CRM_API_KEY=
# PAYMENTS_API_KEY=                     # read-only key if the provider offers one
# HELPDESK_API_KEY=
# ANALYTICS_API_KEY=
# REPO_TOKEN=                           # scoped to the repo, read + PR, never admin
